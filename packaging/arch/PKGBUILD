# Personal Arch package. Builds the committed `main` branch of the repo this
# file lives in. Use ./install_or_update.sh and ./uninstall.sh.
pkgname=music-looper
pkgver=0.1.0.r3.g8e5d94c
pkgrel=1
pkgdesc="Finds seamless loop points in music and reads/writes loop tags"
arch=('x86_64')
license=('MIT')
depends=('gcc-libs' 'glibc')
makedepends=('cargo' 'git')
source=("music-looper::git+file://${startdir%/packaging/arch}#branch=main")
sha256sums=('SKIP')

pkgver() {
  cd music-looper
  printf "%s.r%s.g%s" \
    "$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)" \
    "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd music-looper
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd music-looper
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

package() {
  cd music-looper
  install -Dm755 target/release/music-looper "$pkgdir/usr/bin/music-looper"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
